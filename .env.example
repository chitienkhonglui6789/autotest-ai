# ========================================================
# AutoTest Studio - Cấu hình mô hình AI & Triển khai
# ========================================================

# Nhà cung cấp LLM: openai-compatible (mặc định), groq, openai, ollama, vllm
LLM_PROVIDER=openai-compatible

# Khóa API của LLM (để trống nếu model local không yêu cầu, hoặc đặt token/virtual key)
LLM_API_KEY=***

# Địa chỉ endpoint LLM chuẩn OpenAI-compatible (/chat/completions)
# - Dùng LLM nội bộ mạng LAN (LiteLLM, vLLM, Ollama, Qwen, LocalAI):
#   Ví dụ: http://192.168.1.50:5000/api hoặc http://192.168.1.50:11434/v1
# - Dùng OpenAI: https://api.openai.com/v1
# - Dùng Groq (nếu có Internet): https://api.groq.com/openai/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Tên Model AI dùng chung cho toàn bộ hệ thống (phân rã kịch bản + click/type tự động)
# - Hoạt động tổng quát với mọi model (Qwen, LLaMA, DeepSeek, Mistral, GPT, v.v.):
#   Ví dụ: qwen3.8-27b, qwen2.5:14b, llama3.3:70b, gpt-4o-mini
LLM_MODEL=qwen3.8-27b

# Timeout khi gọi LLM (milliseconds, tối thiểu 90s cho server nội bộ)
LLM_TIMEOUT_MS=90000

# Cấu hình Web Server & Trình duyệt
EXTERNAL_PORT=39793
PORT=3000
HOST=0.0.0.0
HEADLESS=true
